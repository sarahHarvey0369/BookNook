@baseUrl = http://localhost:5165
@token = PASTE_YOUR_JWT_HERE

### Get user's library (requires authentication)
GET {{baseUrl}}/api/library
Authorization: Bearer {{token}}

### Get a single book by ID
GET {{baseUrl}}/api/library/3b1e24e1-2b15-4cbd-b062-229dff14f54c
Authorization: Bearer {{token}}

### Add a book to the library
POST {{baseUrl}}/api/library
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "externalBookId": "OL82548W",
    "catalogSource": "OpenLibrary",
    "title": "Harry Potter and the Philosopher's Stone",
    "authors": ["J. K. Rowling"],
    "description": "A young wizard begins his journey at Hogwarts.",
    "isbn": "9780747532699",
    "publisher": "Bloomsbury",
    "publishedYear": 1997,
    "pageCount": 223
}

### Update reading progress
PUT {{baseUrl}}/api/library/3b1e24e1-2b15-4cbd-b062-229dff14f54c/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "status": 1,
    "currentPage": 50
}

### Mark book as Read
PUT {{baseUrl}}/api/library/3b1e24e1-2b15-4cbd-b062-229dff14f54c/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "status": 2,
    "currentPage": 223
}

### Test invalid reading progress
PUT {{baseUrl}}/api/library/3b1e24e1-2b15-4cbd-b062-229dff14f54c/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "status": 1,
    "currentPage": 300
}

### Delete book from library
DELETE {{baseUrl}}/api/library/3b1e24e1-2b15-4cbd-b062-229dff14f54c
Authorization: Bearer {{token}}